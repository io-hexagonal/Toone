# Toone landing site — environment variables.
# NEXT_PUBLIC_* values are inlined into the browser bundle at build time.
# The other values are read on the server only (route handlers, server
# components) and must never be prefixed NEXT_PUBLIC_.

# Base URL of the Toone auth API (Go backend), used from the browser by
# authentication and the early-access form.
# Default when unset: https://api.trytoone.com/v1
# Local dev against a local server:
#   NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/v1
NEXT_PUBLIC_API_BASE_URL=https://api.trytoone.com/v1

# Google OAuth client ID for Google Identity Services (ID-token flow) on
# /signin and /signup. When unset, the Google button renders disabled with
# a "Soon" badge and only email/password auth is offered.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- Explore (public routine and bundle directory) -------------------------

# Versioned API base the server components fetch the public catalog from
# (docs/architecture/explore/contract.md §11). Server-only: it is read at
# request/revalidation time, not inlined. `cover_url` paths in API responses
# are joined onto this base. Both api.trytoone.com and api.truleaf.org resolve
# to the same server under different path prefixes:
#   https://api.trytoone.com/v1
#   https://api.truleaf.org/api/v1/toone
# Local dev against the fixture mock (`npm run explore:mock`):
#   EXPLORE_API_BASE_URL=http://localhost:8787/v1
# Default when unset: https://api.trytoone.com/v1
EXPLORE_API_BASE_URL=https://api.trytoone.com/v1

# Shared secret for the server -> web revalidation webhook (contract §9).
# The Go server signs each POST /api/revalidate body with
# HMAC-SHA256(secret, raw body) in `X-Explore-Signature: sha256=<hex>`.
# Must equal EXPLORE_REVALIDATE_SECRET on the server. When unset, the
# handler returns 503; forged or malformed signed requests return 401.
EXPLORE_REVALIDATE_SECRET=
