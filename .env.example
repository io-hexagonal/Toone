# Toone landing site — environment variables (all NEXT_PUBLIC_*, inlined at build time)

# Base URL of the Toone auth API (Go backend).
# Used by both authentication and the early-access form.
# Default when unset: https://api.trytoone.com/v1
# Local dev against a local server:
#   NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/v1
NEXT_PUBLIC_API_BASE_URL=https://api.trytoone.com/v1

# Google OAuth client ID for Google Identity Services (ID-token flow) on
# /signin and /signup. When unset, the Google button renders disabled with
# a "Soon" badge and only email/password auth is offered.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
